{
  "_comment": "FIELD54 Stage A states: build_states at 54 km from the native 54 km covariate grids under HOUFIN_DATA54 (see config/overlays/field54_data.json). Same streams, order, ema_tau and transforms as config/esk_desk_config.json states.streams -- only grid_dir changes (lists replace on merge, so the full list is restated). Output under HOUFIN_PROCESSED54, never the 27 km hist_dir.",
  "paths": {
    "data_dir": "${HOUFIN_DATA54}",
    "hist_dir": "${HOUFIN_PROCESSED54}/states"
  },
  "latent_cube": {
    "water_mask_path": "${HOUFIN_DATA54}/land_mask/ocean_mask_54km.tif"
  },
  "states": {
    "streams": [
      {"name": "climate", "type": "per_variable", "grid_dir": "${HOUFIN_DATA54}/climate_grid_monthly", "ema_tau": 2},
      {"name": "landuse", "type": "per_variable", "grid_dir": "${HOUFIN_DATA54}/luh3_grid", "ema_tau": 2},
      {"name": "hyde", "type": "per_variable", "grid_dir": "${HOUFIN_DATA54}/hyde35_grid", "ema_tau": 2,
       "transform": {"type": "log1p"}},
      {"name": "bui", "type": "per_variable", "grid_dir": "${HOUFIN_DATA54}/bui_grid", "ema_tau": 2,
       "transform": {"type": "log1p"}, "indicator_variable": "bui_avail"},
      {"name": "soil", "type": "static", "grid_dir": "${HOUFIN_DATA54}/soilgrids_grid"},
      {"name": "elevation", "type": "static", "grid_dir": "${HOUFIN_DATA54}/elevation", "suffix": ".tif"}
    ]
  }
}
