      "n50_raw": -2.7969046060186082,
      "obs_route_sd": 0.7
    },
    "dispersal_departure": {
      "form": "veit"
    },
    "covariate_drift": {
      "form": "covariate",
      "window_start": 1966,
      "shape": "linear",
      "budget": 0.2,
      "covariates": [
        "log_popd"
      ],
      "fields": [
        "capacity"
      ]
    }
  },
  "run_names": {
