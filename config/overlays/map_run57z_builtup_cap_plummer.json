{
  "_comment": [
    "run_57z (REFERENCE only): built-up x capacity with the Plummer et al. 2019 ramp (hinge-exponential fit to digitised UK bird-food product counts: flat to 1979.5, +0.090/yr in log products) -> ramp 1979.5-2005, held after. Not a candidate for the final model.",
    "E057 P2 (proxy drift): the effect of a named covariate on a vital rate changes over time, sum_c a_c,field * x_c(cell,t) * g(t); x standardised (sd units); g held before 1966 and observation-centred. Base 59a (V&L dispersal, n50 pinned, route effects sd .7)."
  ],
  "input_dir": "${HOUFIN_PROCESSED}/model_inputs/numpyro_input_vl",
  "population_model": {
    "dispersal_random_enabled": false,
    "manifold_prior": {
      "form": "exchangeable",
      "coupling_target": 0.85,
      "coupling_logit_scale": 0.15,
      "amplitude_scale": [
        1.0263,
        1.0263,
        1.0227,
        1.0263
      ],
      "fixed_coupling": null
    },
    "habitat_centering": "occupied",
    "capacity_level_prior": {
      "target_level_median_route_counts": 3.0,
      "alpha_k_scale": 1.0
    },
    "allee_prior": {
      "n50_raw_loc": -3.4915,
      "n50_raw_scale": 0.25
    },
    "juvenile_survival": {
      "form": "ratio",
      "ratio_logit_loc": 0.405,
      "ratio_logit_scale": 0.5
    },
    "settlement": {
      "form": "none"
    },
    "invasion_pulse_prior": {
      "form": "single",
      "n_sites": 1,
      "n_years": 1,
      "total_median": 1.0,
      "total_log_sd": 1.0,
      "global_q50_route_counts": 0.7083
    },
    "dispersal_kernel": {
      "band_weights": false
    },
    "disease_prior": {
      "target": "survival",
      "mortality_ceiling": 0.8
    },
    "observation": {
      "form": "breeding",
      "fledgling_weight_a": 1.0,
      "fledgling_weight_b": 4.0,
      "conc_density_power": true,
      "conc_density_power_scale": 0.5,
      "route_effects": true
    },
    "fecundity_prior": {
      "loc": 4.993,
      "scale": 0.75
    },
    "pinned_sites": {
      "n50_raw": -2.7969046060186082,
      "obs_route_sd": 0.7
    },
    "dispersal_departure": {
      "form": "veit"
    },
    "covariate_drift": {
      "form": "covariate",
      "window_start": 1966,
      "shape": "ramp",
      "budget": 0.2,
      "covariates": [
        "builtup"
      ],
      "fields": [
        "capacity"
      ],
      "ramp": [
        1979.5,
        2005.0
      ]
    }
  },
  "run_names": {
    "map": "age_map_{precision}_run_57z",
    "vis_map": "age_map_{precision}_run_57z"
