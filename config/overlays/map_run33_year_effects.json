{
  "_comment": [
    "run_33 = run_32 (block-3 settlement + single release + learned kernel tail) + disease as mortality + CONTINENTAL YEAR EFFECTS on expected counts (year_effects: sd ~ HalfNormal(0.3), non-centred, centred over observed years).",
    "Why (research/age_model E025): lambda0 ~1.6 persists with every structural fix; a deterministic model may be chasing survey-wide annual swings with fast dynamics."
  ],
  "input_dir": "${HOUFIN_PROCESSED}/model_inputs/numpyro_input",
  "population_model": {
    "dispersal_random_enabled": false,
    "manifold_prior": {
      "form": "exchangeable",
      "coupling_target": 0.85,
      "coupling_logit_scale": 0.15,
      "amplitude_scale": [
        1.0263,
        1.0263,
        1.0227,
        1.0263
      ],
      "fixed_coupling": 1.0
    },
    "habitat_centering": "occupied",
    "capacity_level_prior": {
      "target_level_median_route_counts": 3.0,
      "alpha_k_scale": 1.0
    },
    "allee_prior": {
      "n50_raw_loc": -3.4915,
      "n50_raw_scale": 0.25
    },
    "juvenile_survival": {
      "form": "ratio",
      "ratio_logit_loc": 0.0,
      "ratio_logit_scale": 0.5
    },
    "settlement": {
      "form": "ideal_free",
      "block": 3
    },
    "invasion_pulse_prior": {
      "form": "single",
      "n_sites": 1,
      "n_years": 1,
      "total_median": 1.0,
      "total_log_sd": 1.0,
      "global_q50_route_counts": 0.7083
    },
    "dispersal_kernel": {
      "band_weights": true,
      "band_logw_scale": 1.0
    },
    "disease_prior": {
      "target": "survival",
      "mortality_ceiling": 0.8
    },
    "year_effects": {
      "enabled": true,
      "sd_scale": 0.3
    }
  },
  "run_names": {
    "map": "age_map_{precision}_run_33_new_z",
    "vis_map": "age_map_{precision}_run_33_new_z"
  }
}
