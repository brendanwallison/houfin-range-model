{
  "_comment": [
    "run_41 = run_40 Phase 1 structure with PERSISTENT ROUTE EFFECTS in place of kappa (observation.route_effects: per-route log multipliers, sd ~ HalfNormal(0.5), non-centred; pseudo-zeros none). Needs obs_route_ids.npz (research/age_model/exp/build_route_ids.py).",
    "Why (user, 2026-10-17): kappa cut the plains' Fisher-information share 15% -> 9% (a partial off-switch for low density); plains patchiness is persistent (towns), so a fixed route offset should explain it without discounting each observation's information about the cell mean."
  ],
  "input_dir": "${HOUFIN_PROCESSED}/model_inputs/numpyro_input",
  "population_model": {
    "dispersal_random_enabled": false,
    "manifold_prior": {
      "form": "exchangeable",
      "coupling_target": 0.85,
      "coupling_logit_scale": 0.15,
      "amplitude_scale": [
        1.0263,
        1.0263,
        1.0227,
        1.0263
      ],
      "fixed_coupling": null
    },
    "habitat_centering": "occupied",
    "capacity_level_prior": {
      "target_level_median_route_counts": 3.0,
      "alpha_k_scale": 1.0
    },
    "allee_prior": {
      "n50_raw_loc": -3.4915,
      "n50_raw_scale": 0.25
    },
    "juvenile_survival": {
      "form": "ratio",
      "ratio_logit_loc": 0.405,
      "ratio_logit_scale": 0.5
    },
    "settlement": {
      "form": "ideal_free",
      "block": 3,
      "apply_to": "dispersers"
    },
    "invasion_pulse_prior": {
      "form": "single",
      "n_sites": 1,
      "n_years": 1,
      "total_median": 1.0,
      "total_log_sd": 1.0,
      "global_q50_route_counts": 0.7083
    },
    "dispersal_kernel": {
      "band_weights": true,
      "band_logw_scale": 1.0
    },
    "disease_prior": {
      "target": "survival",
      "mortality_ceiling": 0.8
    },
    "observation": {
      "form": "breeding",
      "fledgling_weight_a": 1.0,
      "fledgling_weight_b": 4.0,
      "route_effects": true,
      "route_sd_scale": 0.5
    },
    "fecundity_prior": {
      "loc": 4.993,
      "scale": 0.75
    }
  },
  "run_names": {
    "map": "age_map_{precision}_run_41_route_fx",
    "vis_map": "age_map_{precision}_run_41_route_fx"
  }
}
