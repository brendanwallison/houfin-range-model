{
  "_comment": [
    "run_28c = run_25 with settlement.weight = capacity_fitness: block shares in proportion to K * lambda0^tau, tau ~ HalfNormal(2) learned (tau = 0 is run_25's capacity weighting).",
    "Why: E014 -- perfect fitness sorting (run_28a) emptied every below-par cell, so the fit flattened all vital rates; tau lets the data choose how selective settlement is."
  ],
  "input_dir": "${HOUFIN_PROCESSED}/model_inputs/numpyro_input",
  "population_model": {
    "dispersal_random_enabled": false,
    "manifold_prior": {
      "form": "exchangeable",
      "coupling_target": 0.85,
      "coupling_logit_scale": 0.15,
      "amplitude_scale": [
        1.0263,
        1.0263,
        1.0227,
        1.0263
      ],
      "fixed_coupling": 1.0
    },
    "habitat_centering": "occupied",
    "capacity_level_prior": {
      "target_level_median_route_counts": 3.0,
      "alpha_k_scale": 1.0
    },
    "allee_prior": {
      "n50_raw_loc": -3.4915,
      "n50_raw_scale": 0.25
    },
    "juvenile_survival": {
      "form": "ratio",
      "ratio_logit_loc": 0.0,
      "ratio_logit_scale": 0.5
    },
    "settlement": {
      "form": "ideal_free",
      "block": 3,
      "weight": "capacity_fitness",
      "tau_scale": 2.0
    }
  },
  "run_names": {
    "map": "age_map_{precision}_run_28c_new_z",
    "vis_map": "age_map_{precision}_run_28c_new_z"
  }
}
