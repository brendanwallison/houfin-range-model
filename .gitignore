# SLURM writes job logs and 30-second GPU/host telemetry into the submit dir (the
# repo). They are run artifacts, not source -- and while untracked they made
# "is the tree clean?" checks (e.g. submit_juv_mdd_sweep.sh's preflight) fire.
houfin_*.o*
houfin_*.e*
gpu_*.csv
# REMORA writes one directory per job (plus one per resubmit), so a few months of runs
# leaves several hundred of them and `git status` stops being readable -- which is how a
# genuinely stray file goes unnoticed among them.
remora_*/
# submit_sweep.sh generates its per-task script into the submit dir.
.sweep_task_*.sh
# Diagnostics that write their report into the cwd rather than $HOUFIN_PROCESSED.
basis_domain_gap.json
download*.log
# Pulled run outputs (reports + job logs scp'd off TACC). Data artifacts, not source --
# processed outputs live under $HOUFIN_PROCESSED, never inside the repo.
results/

# Generated report PDFs -- regenerable in seconds from the prediction files
# (scripts/viz/sdm_benchmark_report.py), and they churn on every refit.
*.pdf

# Model/analysis artifacts. results/ is already ignored wholesale, but fitted
# objects and arrays also land in the repo root when a script is run from here
# (laplace.npz, map_params.pkl, probe.json from the HMC work). None of these
# belong in git: they are large, binary, and regenerable from the pipeline.
*.npz
*.npy
*.pkl
/probe.json

# Machine-local worktrees and disposable root-level experiment probes. Maintained
# dispatchers belong under research/bin and remain tracked.
/.worktrees/
/.*.sh
/.pytest_cache/
# Downloaded R packages and installation output, not the reproducible R scripts.
/research/r/lib/
/research/r/install.log
/research/r/install.err

# Local scratch, completion flags, and raw diagnostic logs. Retain the scripts
# and compact research reports alongside them.
/research/_tmp_c.py
/research/experiments/lambda_audit_20261026/basis_readout_audit.log
/research/experiments/local_native_crash_20261103/kernel.txt
/research/experiments/local_native_crash_20261103/*_tail.txt
/research/experiments/final_shared_round1_20261025/earlier_clean_split_diagnostics/MAP_DIAGNOSTICS_DONE

